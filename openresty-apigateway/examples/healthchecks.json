{
  "defaults": {
    "path": "/health",
    "interval": 2000,
    "timeout": 1000,
    "fall": 2,
    "rise": 2,
    "valid_statuses": [200, 204]
  },
  "upstreams": {
    "orders_api": {
      "path": "/actuator/health",
      "host": "orders"
    },
    "users_api": {
      "path": "/actuator/health/readiness",
      "host": "users"
    },
    "billing_api": {
      "type": "https",
      "host": "billing.internal.example.com",
      "path": "/healthz"
    }
  }
}
